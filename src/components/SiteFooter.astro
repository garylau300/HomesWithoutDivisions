---
import { localeHref, useTranslations, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  page: string;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const logoAlt = `${t.site.name} ${t.site.nameSecondary}`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__identity">
      {/* The project lockup itself, as the header uses it. */}
      <img
        class="site-footer__lockup"
        src="/brand/hwd-lockup-660.png"
        alt={logoAlt}
        width="660"
        height="128"
        loading="lazy"
        decoding="async"
      />
      <p class="site-footer__motto">{t.site.motto}</p>
    </div>

    <nav class="site-footer__nav" aria-label={t.nav.menu}>
      <ul>
        <li><a href={localeHref(locale)}>{t.nav.home}</a></li>
        <li><a href={localeHref(locale, '/about')}>{t.nav.about}</a></li>
        <li><a href={`${localeHref(locale)}#resources`}>{t.nav.resources}</a></li>
      </ul>
    </nav>

    <div class="site-footer__legal">
      <img
        class="site-footer__partner"
        src="/brand/probono-hk.png"
        alt={t.footer.partnerAlt}
        width="472"
        height="190"
        loading="lazy"
        decoding="async"
      />
      <p class="site-footer__initiative">{t.site.initiative}</p>
      <p>{t.footer.licence}</p>
      <p class="site-footer__copyright">
        {t.footer.copyright.replace('©', `© ${year}`)}
      </p>
    </div>
  </div>

  <a class="site-footer__top" href={`${localeHref(locale, page)}#main`}>
    <span aria-hidden="true">↑</span>
    {t.footer.backToTop}
  </a>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--space-2xl) var(--space-l);
    background: var(--footer-bg);
    border-top: 1px solid var(--rule);
    color: var(--c-eerie);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.1fr) auto minmax(0, 1.25fr);
      column-gap: var(--space-2xl);
      row-gap: var(--space-l);
    }
  }

  .site-footer__identity {
    display: grid;
    justify-items: start;
    /* Without this the grid row stretches and the motto drifts from the lockup. */
    align-content: start;
    gap: var(--space-xs);
  }

  .site-footer__lockup {
    width: auto;
    height: 3.25rem;
  }

  .site-footer__motto {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .site-footer__nav {
    align-self: start;
  }

  .site-footer__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration-color: color-mix(in srgb, var(--c-eerie) 35%, transparent);
  }

  .site-footer__nav a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__legal {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 46ch;
  }

  .site-footer__partner {
    width: auto;
    object-fit: contain;
    height: 4rem;
    margin-block-end: var(--space-3xs);
  }

  .site-footer__initiative {
    font-weight: 600;
    color: var(--ink);
  }

  .site-footer__copyright {
    color: var(--ink);
  }

  .site-footer__top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs);
    width: min(100% - var(--gutter) * 2, var(--width-page));
    margin: var(--space-xl) auto 0;
    padding-block-start: var(--space-s);
    border-top: 1px solid color-mix(in srgb, var(--c-eerie) 14%, transparent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .site-footer__top:hover {
    text-decoration: underline;
  }
</style>
