---
import { localeHref, useTranslations, type Locale } from '../lib/i18n';
import LangToggle from './LangToggle.astro';
import HouseIcon from './HouseIcon.astro';

interface Props {
  locale: Locale;
  page: string;
  /**
   * On the landing page the lockup *is* the page's title — the hero carries no
   * name of its own — so it starts large and shrinks into the bar as the reader
   * scrolls.
   */
  prominent?: boolean;
}

const { locale, page, prominent = false } = Astro.props;
const t = useTranslations(locale);
const logoAlt = `${t.site.name} ${t.site.nameSecondary}`;

/** The landing page has no other <h1>, so the lockup provides it. */
const Wrapper = prominent ? 'h1' : 'div';

const links = [
  { href: localeHref(locale), label: t.nav.home, page: '' },
  { href: localeHref(locale, '/about'), label: t.nav.about, page: '/about' },
];
---

<header class:list={['site-header', prominent && 'site-header--prominent']} data-site-header>
  <div class="site-header__inner container">
    <Wrapper class="site-header__title">
      <a class="site-header__logo" href={localeHref(locale)} aria-label={`${logoAlt} — ${t.nav.home}`}>
      {/* The full lockup where there is room; the mark alone on a narrow screen. */}
      <img
        class="site-header__lockup"
        src="/brand/hwd-lockup-660.png"
        alt={logoAlt}
        width="660"
        height="128"
        decoding="async"
      />
        <HouseIcon id="header-mark" class="site-header__mark" size={38} />
      </a>
    </Wrapper>

    <nav class="site-header__nav" aria-label={t.nav.menu}>
      <ul class="site-header__links">
        {
          links.map((link) => (
            <li>
              <a
                class="site-header__link"
                href={link.href}
                aria-current={link.page === page ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <LangToggle locale={locale} page={page} />
    </nav>
  </div>
</header>

<script>
  // Condense the header once the page has scrolled past the hero's top edge.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    /*
     * Drives a 0→1 progress value that the CSS interpolates the logo size from,
     * so the lockup shrinks smoothly with the scroll rather than snapping between
     * two sizes. Reads are batched into a frame to keep it off the scroll thread.
     */
    const RUNWAY = 220;
    let queued = false;

    const apply = () => {
      queued = false;
      const progress = Math.min(1, Math.max(0, window.scrollY / RUNWAY));
      header.style.setProperty('--scroll-progress', progress.toFixed(4));
      header.classList.toggle('is-condensed', window.scrollY > 24);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* No background of its own: the bar sits on the hero until you scroll. */
    background: transparent;
  }

  /*
   * The bar's surface is a separate layer whose opacity follows the same scroll
   * progress as the logo, so it fades in with the scroll rather than snapping on
   * at a threshold. At the top of the page it is fully transparent and the
   * header reads as part of the hero; by the end of the runway it is the
   * translucent, blurred bar with its hairline and shadow.
   */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    box-shadow: var(--shadow-s);
    opacity: var(--scroll-progress, 0);
    transition: opacity var(--dur) var(--ease-out);
    pointer-events: none;
  }

  /* Without scripting the progress never advances, so show the solid bar. */
  :global(html:not(.js)) .site-header::before {
    opacity: 1;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    /* A little air above the mark before the page begins. */
    padding-block: var(--space-s) var(--space-xs);
    transition: padding-block var(--dur) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    /* No scroll-linked resize or fade: hold the settled bar from the start. */
    .site-header__lockup {
      height: var(--logo-min);
    }

    .site-header::before {
      opacity: 1;
    }
  }

  .site-header.is-condensed .site-header__inner {
    padding-block: var(--space-xs) var(--space-2xs);
  }

  .site-header__title {
    /*
     * flex: none is load-bearing. As a flex item the lockup was being compressed
     * horizontally while its height stayed fixed by the calc below, squashing the
     * wordmark by up to 35% between 545px and 700px wide. Its aspect ratio is now
     * never the thing that gives.
     */
    flex: none;
    margin: 0;
    font-size: inherit;
    line-height: 0;
  }

  .site-header__logo {
    display: flex;
    flex: none;
    align-items: center;
    border-radius: var(--radius-s);
  }

  /*
   * --logo-min/--logo-max are the two ends of the scroll interpolation. Off the
   * landing page they are equal, so the lockup simply holds its size.
   */
  .site-header {
    --logo-min: 2.5rem;
    --logo-max: 2.5rem;
  }

  .site-header--prominent {
    --logo-min: 2.25rem;
    /* Fluid, so the bar still fits its nav on a narrow tablet. */
    --logo-max: clamp(2.75rem, 1.9rem + 2.4vw, 3.75rem);
  }

  .site-header__lockup {
    width: auto;
    /* Belt and braces: never let the wordmark stretch, whatever squeezes it. */
    object-fit: contain;
    height: calc(
      var(--logo-max) - (var(--logo-max) - var(--logo-min)) * var(--scroll-progress, 0)
    );
  }

  /* Without JavaScript --scroll-progress is never set, so the lockup would sit
     at its largest for the whole page. Settle it at the small size instead. */
  :global(html:not(.js)) .site-header__lockup {
    height: var(--logo-min);
  }

  /*
   * :global() is required, not incidental. The mark is rendered by HouseIcon, so
   * it carries that component's scope attribute rather than this one's — a plain
   * `.site-header__mark` rule here never matches it, which is how the lockup and
   * the mark ended up showing side by side on wide screens.
   */
  :global(.site-header__mark) {
    display: none;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.375rem;
    padding-inline: var(--space-xs);
    border-radius: var(--radius-pill);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .site-header__link:hover {
    background: var(--c-pale-pink);
    color: var(--c-eerie);
  }

  /* The current page is underlined as well as tinted, so it is not colour alone. */
  .site-header__link[aria-current='page'] {
    background: var(--c-pale-pink);
    text-decoration: underline;
    text-decoration-color: var(--c-coral);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 44rem) {
    .site-header__lockup {
      display: none;
    }

    :global(.site-header__mark) {
      display: block;
    }

    .site-header__nav {
      gap: var(--space-2xs);
    }
  }

  /* On the narrowest phones the bar's contents have to give up their padding. */
  @media (max-width: 24rem) {
    .site-header__inner,
    .site-header__nav {
      gap: var(--space-3xs);
    }

    .site-header__links {
      gap: 0;
    }

    .site-header__link {
      padding-inline: var(--space-2xs);
    }

    /*
     * The mark to its left is already the Home link, so on the narrowest phones
     * the separate Home item is redundant — and dropping it is what lets
     * "About us" stay on one line.
     */
    .site-header__links li:first-child {
      display: none;
    }
  }
</style>
