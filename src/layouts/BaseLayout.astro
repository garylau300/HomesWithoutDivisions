---
import { LOCALES, useTranslations, type Locale } from '../lib/i18n';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  locale: Locale;
  /** Route below the language segment: '' for the landing page, '/about' etc. */
  page: string;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const t = useTranslations(locale);
const canonical = new URL(`/${locale}${page}`, Astro.site);
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      /*
       * Real URLs per language mean the toggle works without JavaScript and
       * search engines can index both.
       */
    }
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={useTranslations(l).meta.htmlLang}
          href={new URL(`/${l}${page}`, Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(`/zh${page}`, Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFBF5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_HK' : 'en_GB'} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The two faces every page renders; the rest load only if used. */}
    <link
      rel="preload"
      href="/fonts/QuireSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/QuireSans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700&display=swap"
    />

    {
      /*
       * Marks the document before first paint so scroll-reveal can start hidden.
       * Without JavaScript the class is never set and all content stays visible.
       */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      /*
       * Hiding the page before revealing it means a reveal that never runs
       * leaves the content invisible for good — a broken script, a network
       * failure, a blocked bundle. So arm a failsafe here and let the reveal
       * module disarm it by announcing itself; if it never does, the content
       * is shown rather than lost.
       */
      setTimeout(function () {
        var root = document.documentElement;
        if (!root.classList.contains('reveal-ready')) root.classList.add('no-reveal');
      }, 2000);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <SiteHeader locale={locale} page={page} prominent={page === ''} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} page={page} />

    <script>
      import { initReveal } from '../lib/client/reveal';

      initReveal();
    </script>
  </body>
</html>

<style>
  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }
</style>
