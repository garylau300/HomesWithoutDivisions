---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeliverableCard from '../../components/DeliverableCard.astro';
import HouseIcon from '../../components/HouseIcon.astro';
import { DELIVERABLES, PILLARS } from '../../data/deliverables';
import { LOCALES, localeHref, useTranslations, type Locale } from '../../lib/i18n';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page=""
  title={t.home.title}
  description={t.site.description}
>
  <!-- ===== Hero ========================================================== -->
  <section class="hero">
    <div class="hero__decor" aria-hidden="true">
      <span class="hero__blob hero__blob--mint"></span>
      <span class="hero__blob hero__blob--coral"></span>
    </div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">{t.home.hero.eyebrow}</p>

        {/* The three pillars, as a colour signature above the motto. */}
        <p class="hero__bars" aria-hidden="true">
          <span class="hero__bar hero__bar--communication"></span>
          <span class="hero__bar hero__bar--terms"></span>
          <span class="hero__bar hero__bar--solution"></span>
        </p>

        <p class="hero__motto">{t.site.motto}</p>

        <div class="hero__actions">
          <a class="button" href="#resources">{t.home.hero.ctaPrimary}</a>
          <a class="button button--ghost" href={localeHref(locale, '/about')}>
            {t.home.hero.ctaSecondary}
          </a>
        </div>
      </div>

      {/* Three arches in the three pillar colours, the mark standing inside them. */}
      <div class="hero__figure" aria-hidden="true">
        <svg class="hero__arches" viewBox="0 0 400 240" role="presentation">
          {/* Half-annuli sharing a baseline, sized so the mark stands inside. */}
          <path
            class="hero__arch hero__arch--communication"
            d="M4 230A196 196 0 0 1 396 230L360 230A160 160 0 0 0 40 230Z"></path>
          <path
            class="hero__arch hero__arch--terms"
            d="M44 230A156 156 0 0 1 356 230L320 230A120 120 0 0 0 80 230Z"></path>
          <path
            class="hero__arch hero__arch--solution"
            d="M84 230A116 116 0 0 1 316 230L280 230A80 80 0 0 0 120 230Z"></path>
        </svg>
        <HouseIcon id="hero-mark" class="hero__mark" size={104} animated />
      </div>
    </div>
  </section>

  <!-- ===== The three deliverables ======================================== -->
  <section class="section resources" id="resources" aria-labelledby="resources-heading">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{t.home.deliverables.eyebrow}</p>
        <h2 id="resources-heading">{t.home.deliverables.heading}</h2>
        <p class="section-head__lead">{t.home.deliverables.lead}</p>
      </header>

      <div class="resources__grid">
        {
          DELIVERABLES.map((deliverable, index) => (
            <DeliverableCard deliverable={deliverable} locale={locale} delay={index * 110} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== The three pillars ============================================= -->
  <section class="section section--tight pillars" aria-labelledby="pillars-heading">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{t.home.pillars.eyebrow}</p>
        <h2 id="pillars-heading">{t.home.pillars.heading}</h2>
        <p class="section-head__lead">{t.home.pillars.lead}</p>
      </header>

      <ol class="pillars__list">
        {
          PILLARS.map((pillar, index) => {
            const copy = t.deliverables[pillar.deliverable];
            const pillarCopy = t.pillars[pillar.id];
            return (
              <li
                class="pillars__item"
                data-reveal
                style={`--pillar-accent: ${pillar.accent}; --pillar-tint: ${pillar.accentTint}; --reveal-delay: ${index * 90}ms;`}
              >
                <span class="pillars__rule" aria-hidden="true" />
                <h3 class="pillars__name">{pillarCopy.name}</h3>
                <p class="pillars__resource">{copy.name}</p>
              </li>
            );
          })
        }
      </ol>

      <p class="pillars__cta" data-reveal>
        <a class="button button--ghost" href={localeHref(locale, '/about')}>
          {t.home.pillars.cta}
        </a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---------------------------------------------------------------- */

  .hero {
    position: relative;
    /* Clips the washes' horizontal bleed; body's overflow-x does not reach them. */
    overflow: hidden;
    /*
     * Bottom padding is deliberately smaller than the top: the resources
     * section right below is what the two buttons above point at, and the
     * closer they read together the more the "See the three resources" button
     * feels like it leads somewhere rather than into empty space.
     */
    padding-block: var(--space-xl) var(--space-l);
  }

  .hero__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /*
     * The washes are taller than the hero, so `overflow: hidden` was slicing
     * their blur mid-gradient and drawing hard lines across the full width —
     * one right under the transparent header, reading as exactly the border the
     * header is meant not to have. Fading the whole layer out top and bottom
     * removes the cut regardless of how the washes are sized or placed. Their
     * sideways bleed is still clipped, where the viewport edge hides it.
     */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 76%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 76%, transparent 100%);
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(56px);
    opacity: 0.5;
  }

  /*
   * Both washes clear the section's top edge. Crossing it meant the clip cut the
   * blur mid-gradient, drawing a hard line straight across the page directly
   * under the transparent header — reading as exactly the border the header is
   * meant not to have. Sideways they still bleed, where the viewport edge hides
   * the cut.
   */
  .hero__blob--mint {
    width: min(32rem, 66vw);
    aspect-ratio: 1;
    inset-block-start: 1rem;
    inset-inline-start: -15rem;
    background: var(--c-opal);
    animation: drift-a 26s var(--ease-out) infinite alternate;
  }

  .hero__blob--coral {
    width: min(28rem, 62vw);
    aspect-ratio: 1;
    inset-block-start: 4rem;
    inset-inline-end: -11rem;
    background: var(--c-pale-pink);
    animation: drift-b 32s var(--ease-out) infinite alternate;
  }

  @keyframes drift-a {
    to {
      transform: translate3d(3rem, 2rem, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(-2.5rem, 3rem, 0) scale(1.1);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
    }
  }

  .hero__content {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    text-align: start;
  }

  /* Each element rises in turn, so the eye lands on the motto. */
  .hero__eyebrow,
  .hero__bars,
  .hero__motto,
  .hero__actions,
  .hero__figure {
    animation: rise 0.75s var(--ease-out) backwards;
  }

  .hero__eyebrow {
    animation-delay: 0.05s;
  }
  .hero__bars {
    animation-delay: 0.16s;
  }
  .hero__motto {
    animation-delay: 0.26s;
  }
  .hero__actions {
    animation-delay: 0.38s;
  }
  .hero__figure {
    animation-delay: 0.2s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  /* ---- The three-colour signature ------------------------------------------ */

  .hero__bars {
    display: flex;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
  }

  .hero__bar {
    display: block;
    width: 4.5rem;
    height: 10px;
    border-radius: var(--radius-pill);
    transform-origin: left center;
    animation: bar-in 0.7s var(--ease-spring) backwards;
  }

  .hero__bar--communication {
    background: var(--accent-communication);
    animation-delay: 0.3s;
  }
  .hero__bar--terms {
    background: var(--accent-terms);
    animation-delay: 0.38s;
  }
  .hero__bar--solution {
    background: var(--accent-solution);
    animation-delay: 0.46s;
  }

  @keyframes bar-in {
    from {
      transform: scaleX(0);
    }
  }

  .hero__motto {
    max-width: 20ch;
    /* Regular weight: the name is already stated boldly in the bar above. */
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c-eerie);
    text-wrap: balance;
  }

  :global(:lang(zh)) .hero__motto {
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-2xs);
  }

  /* ---- The arches ---------------------------------------------------------- */

  .hero__figure {
    position: relative;
    display: grid;
    place-items: end center;
    width: min(26rem, 100%);
    justify-self: center;
  }

  /*
   * :global() is required for anything HouseIcon renders: the mark carries that
   * component's scope attribute, not this page's, so an unscoped selector here
   * never matches it. Without this the mark drops to a second grid row and
   * stands below the arches instead of inside them.
   */
  .hero__figure > :global(*) {
    grid-area: 1 / 1;
  }

  .hero__arches {
    width: 100%;
    height: auto;
  }

  .hero__arch {
    transform-origin: bottom center;
    animation: arch-rise 0.9s var(--ease-spring) backwards;
  }

  .hero__arch--communication {
    fill: var(--accent-communication);
    animation-delay: 0.3s;
  }
  .hero__arch--terms {
    fill: var(--accent-terms);
    animation-delay: 0.42s;
  }
  .hero__arch--solution {
    fill: var(--accent-solution);
    animation-delay: 0.54s;
  }

  @keyframes arch-rise {
    from {
      transform: scaleY(0);
    }
  }

  /*
   * The mark stands inside the innermost arch. Its own square viewBox carries
   * padding below the house, so it is nudged down to sit on the arches' baseline.
   */
  :global(.hero__mark) {
    /*
     * Sized to clear the innermost arch. At the same colour as that arch, the
     * mark has to stand in open space or its roof merges into the coral band.
     */
    width: 18%;
    height: auto;
    /*
     * The mark's square viewBox carries empty space below the house, so a
     * bottom-aligned icon would hang below the arches. This lifts it by that
     * difference, putting its floor on the arches' baseline. Percentage margins
     * resolve against the figure's width, which is what both sizes derive from.
     */
    margin-block-end: 1.25%;
    justify-self: center;
  }

  /* ---- Shared section head ------------------------------------------------- */

  .section-head {
    display: grid;
    gap: var(--space-2xs);
    max-width: 52rem;
    margin-block-end: var(--space-l);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head__lead {
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  /* ---- Resources ----------------------------------------------------------- */

  .resources {
    /* Narrower than the .section default, to sit close under the hero's buttons. */
    padding-block-start: var(--space-l);
    background: linear-gradient(
      180deg,
      var(--page) 0%,
      color-mix(in srgb, var(--c-opal) 22%, var(--page)) 100%
    );
  }

  .resources__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }

  @media (min-width: 46rem) {
    .resources__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .resources__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- Pillars ------------------------------------------------------------- */

  .pillars {
    background: color-mix(in srgb, var(--c-opal) 22%, var(--page));
  }

  .pillars__list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
    counter-reset: pillar;
  }

  @media (min-width: 42rem) {
    .pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pillars__item {
    display: grid;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
  }

  .pillars__rule {
    display: block;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--pillar-accent);
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* Drawn in full by default; only JavaScript makes it grow on reveal. */
  :global(html.js) .pillars__item .pillars__rule {
    transform: scaleX(0.25);
  }

  :global(html.js) .pillars__item.is-revealed .pillars__rule {
    transform: scaleX(1);
  }

  .pillars__name {
    font-size: var(--step-2);
  }

  .pillars__resource {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .pillars__cta {
    margin-block-start: var(--space-xl);
  }

</style>
