---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarDiagram from '../../components/PillarDiagram.astro';
import Emphasis from '../../components/Emphasis.astro';
import { LOCALES, localeHref, plain, useTranslations, type Locale } from '../../lib/i18n';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const about = t.about;

/*
 * The approach section is an argument that lands on an invitation: its last
 * paragraph stops explaining and addresses the reader directly ("We hope that
 * whoever you are reading this…"). So it steps off the spine and becomes the
 * panel carrying the call to action, while the paragraphs before it are the
 * reasoning the spine runs through. Sliced rather than indexed by 3, so the
 * split still holds if the section grows another paragraph.
 */
const capability = about.capability;
const approachSteps = capability.body.slice(0, -1);
const approachClose = capability.body[capability.body.length - 1];

/*
 * The project's three-colour signature, in the order it appears everywhere else
 * (communication, terms, solution — the hero bars, the cards, the diagram).
 * Cycled, so the spine keeps its rhythm at any number of paragraphs.
 */
const APPROACH_ACCENTS = [
  'var(--accent-communication)',
  'var(--accent-terms)',
  'var(--accent-solution)',
];
---

<BaseLayout
  locale={locale}
  page="/about"
  title={about.title}
  description={plain(about.hero.lead)}
>
  <!-- ===== Hero ========================================================== -->
  <section class="about-hero">
    <div class="container container--narrow about-hero__inner">
      <p class="eyebrow">{about.hero.eyebrow}</p>
      <h1 class="about-hero__heading">{about.hero.heading}</h1>
      <p class="about-hero__lead">{about.hero.lead}</p>
    </div>
  </section>

  <!-- ===== The capability approach — leads the page ====================== -->
  <section class="section capability" aria-labelledby="capability-heading">
    <div class="container container--narrow">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{capability.eyebrow}</p>
        <h2 id="capability-heading">{capability.heading}</h2>
      </header>

      {/*
        * The paragraphs stay paragraphs — no list markup — so this still reads
        * as continuous prose to a screen reader. The spine is drawn entirely
        * from pseudo-elements, which assistive technology never sees, and the
        * reading progress it shows is already obvious to anyone who can see
        * where they are on the page.
        */}
      <div class="approach" data-approach data-reveal>
        {
          approachSteps.map((paragraph, index) => (
            <p
              class="approach__step"
              data-approach-step
              style={`--step-accent: ${APPROACH_ACCENTS[index % APPROACH_ACCENTS.length]};`}
            >
              <Emphasis text={paragraph} />
            </p>
          ))
        }
      </div>

      <div class="approach__close" data-reveal>
        <p class="approach__close-text"><Emphasis text={approachClose} /></p>
        <p class="capability__cta">
          <a class="button" href={`${localeHref(locale)}#resources`}>
            {capability.resourcesCta}
          </a>
        </p>
      </div>
    </div>
  </section>
  <!-- ===== Mission ======================================================= -->
  <section class="section mission" aria-labelledby="mission-heading">
    <div class="container container--narrow">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{about.mission.eyebrow}</p>
        <h2 id="mission-heading">{about.mission.heading}</h2>
      </header>

      <div class="prose" data-reveal>
        {about.mission.body.map((paragraph) => (
          <p>
            <Emphasis text={paragraph} />
          </p>
        ))}
      </div>

      <h3 class="mission__methods-heading" data-reveal>{about.mission.methodsHeading}</h3>
      <ul class="mission__methods">
        {
          about.mission.methods.map((method, index) => (
            <li class="mission__method" data-reveal style={`--reveal-delay: ${index * 110}ms;`}>
              <span class="mission__method-marker" aria-hidden="true">
                {index + 1}
              </span>
              <h4 class="mission__method-name">{method.name}</h4>
              <p class="mission__method-body">{method.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== The three pillars ============================================= -->
  <section class="section pillars-section" aria-labelledby="pillars-heading">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{about.pillars.eyebrow}</p>
        <h2 id="pillars-heading">{about.pillars.heading}</h2>
        <p class="section-head__lead">{about.pillars.lead}</p>
      </header>

      <div data-reveal>
        <PillarDiagram locale={locale} />
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Fills the approach section's spine as the reader moves through it.
  const approach = document.querySelector<HTMLElement>('[data-approach]');

  if (approach) {
    const steps = Array.from(
      approach.querySelectorAll<HTMLElement>('[data-approach-step]'),
    );

    /** The spine complete: what a reader sees without scripting, too. */
    const settle = () => {
      approach.style.setProperty('--read-progress', '1');
      for (const step of steps) step.classList.add('is-reached');
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      settle();
    } else {
      let queued = false;

      const apply = () => {
        queued = false;
        const rect = approach.getBoundingClientRect();
        if (rect.height === 0) return;

        /*
         * Progress is measured against a line a little below the middle of the
         * viewport rather than its top edge: the rail should fill roughly where
         * the eye is, not a screen ahead of it.
         */
        const line = window.innerHeight * 0.62;
        const progress = Math.min(1, Math.max(0, (line - rect.top) / rect.height));
        approach.style.setProperty('--read-progress', progress.toFixed(4));

        for (const step of steps) {
          step.classList.toggle(
            'is-reached',
            step.getBoundingClientRect().top <= line,
          );
        }
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      };

      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }
  }
</script>

<style>
  /* ---- Hero ---------------------------------------------------------------- */

  .about-hero {
    padding-block: var(--space-2xl);
    /* The mint tint, not the pink one: no coral surfaces anywhere on this page. */
    background: linear-gradient(
      180deg,
      var(--accent-communication-tint) 0%,
      var(--page) 100%
    );
  }

  .about-hero__inner {
    display: grid;
    gap: var(--space-xs);
  }

  .about-hero__heading {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .about-hero__lead {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  /* ---- Shared section head ------------------------------------------------- */

  .section-head {
    display: grid;
    gap: var(--space-2xs);
    max-width: 52rem;
    margin-block-end: var(--space-l);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head__lead {
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  /* ---- Mission ------------------------------------------------------------- */

  .mission__methods-heading {
    margin-block-start: var(--space-xl);
    font-size: var(--step-1);
  }

  .mission__methods {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
  }

  @media (min-width: 44rem) {
    .mission__methods {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .mission__method {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-m);
    background: var(--c-floral);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
  }

  .mission__method-marker {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-block-end: var(--space-3xs);
    background: var(--c-eerie);
    color: var(--c-floral);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1;
  }

  .mission__method-name {
    font-size: var(--step-1);
  }

  .mission__method-body {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
  }

  /* ---- Pillars ------------------------------------------------------------- */

  .pillars-section {
    background: color-mix(in srgb, var(--c-opal) 26%, var(--page));
  }

  /* ---- Capability — the approach, as a reading spine ------------------------ */

  /*
   * A rail down the left of the prose, with a dot beside each paragraph. It
   * fills in the three brand colours as the reader moves through the section,
   * so a dense passage of theory shows its own length and how far into it you
   * are. Nothing is hidden behind it: every word is present and readable with
   * the spine drawn, empty, or absent entirely.
   */
  .approach {
    /* Centre of the rail, and the room the rail and its dots need beside the text. */
    --rail-x: 0.5rem;
    --rail-inset: 2.5rem;
    --dot-size: 0.875rem;
    /*
     * Vertical centre of a paragraph's first line, so the dots sit level with
     * the text rather than with the box. Half a line box of body type: --step-0
     * runs 1rem–1.0625rem at --leading-body, so half is 0.825rem–0.877rem. Held
     * as a plain length on purpose — a clamp() substituted into the calc()s
     * below is what collapsed the header logo to nothing once before.
     */
    --dot-centre: 0.85rem;

    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding-inline-start: var(--rail-inset);
  }

  /* The track, and over it the read portion. Insets end the rail at the dots. */
  .approach::before,
  .approach::after {
    content: '';
    position: absolute;
    inset-block: var(--dot-centre);
    inset-inline-start: calc(var(--rail-x) - 1px);
    width: 2px;
    border-radius: var(--radius-pill);
    /*
     * The last paragraph runs on past its own dot, so the rail would otherwise
     * stop dead partway down it. Fading the tail makes it read as the argument
     * carrying on into the panel below rather than as an overshoot. Track and
     * fill are faded together, so it looks the same empty or complete.
     */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 88%, transparent 100%);
  }

  .approach::before {
    background: var(--rule);
  }

  .approach::after {
    background: linear-gradient(
      180deg,
      var(--accent-communication) 0%,
      var(--accent-terms) 50%,
      var(--accent-solution) 100%
    );
  }

  .approach__step {
    position: relative;
    max-width: var(--measure);
  }

  /* The dot, sitting back out in the rail column and centred on the rail. */
  .approach__step::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--dot-centre) - var(--dot-size) / 2);
    inset-inline-start: calc(var(--rail-x) - var(--dot-size) / 2 - var(--rail-inset));
    width: var(--dot-size);
    height: var(--dot-size);
    background: var(--step-accent);
    border: 2px solid var(--step-accent);
    border-radius: 50%;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-spring);
  }

  /*
   * Drawn complete by default, exactly like the pillar rules on the landing
   * page: only once JavaScript is running does the spine start empty and fill
   * with the reading. Without it, nothing is missing — the rail is simply done.
   */
  :global(html.js) .approach::after {
    clip-path: inset(0 0 calc((1 - var(--read-progress, 0)) * 100%) 0);
  }

  :global(html.js) .approach__step::before {
    background: var(--page);
    border-color: var(--rule-strong);
  }

  :global(html.js) .approach__step.is-reached::before {
    background: var(--step-accent);
    border-color: var(--step-accent);
    transform: scale(1.15);
  }

  /* ---- Capability — the closing invitation ---------------------------------- */

  .approach__close {
    margin-block-start: var(--space-xl);
    /*
     * Indented by the rail's inset less the panel's own padding, so the text
     * inside starts on exactly the same line as the paragraphs above it — the
     * panel steps off the spine without stepping out of the column.
     */
    margin-inline-start: var(--space-s);
    padding: var(--space-l) var(--space-m);
    background: var(--accent-communication-tint);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
  }

  .approach__close-text {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .capability__cta {
    margin-block-start: var(--space-l);
  }
</style>
